# Copy this to .env and fill in values. Never commit .env to git.

# Database
DATABASE_URL=postgresql+asyncpg://kickload:kickload_dev_password@localhost:5432/kickload

# GCP Pub/Sub
# Set this to use the local emulator. Remove it to use real GCP Pub/Sub.
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=kickload-local
PUBSUB_TOPIC=kickload-app-events-dev

# Environment
ENV=dev

# Auth (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# GCP (only needed when billing is active)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=kickload-uploads-dev
